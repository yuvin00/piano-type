{
  "name": "piano-type",
  "version": "1.0.2",
  "private": true,
  "description": "Piano melodies for typing on Windows, macOS and the web",
  "author": "yuvin00",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "start": "node scripts/dev-server.cjs",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "pack:win": "electron-builder --win portable --x64",
    "pack:mac": "electron-builder --mac zip --universal"
  },
  "build": {
    "compression": "store",
    "npmRebuild": false,
    "appId": "io.yuvin.pianotype",
    "productName": "Piano Type",
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html",
      "AUDIO-CREDITS.md",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "assets/icons/piano.ico",
      "artifactName": "Piano-Type-Windows.exe"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "artifactName": "Piano-Type-macOS-universal.zip",
      "category": "public.app-category.music",
      "icon": "assets/icons/piano.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSInputMonitoringUsageDescription": "다른 프로그램에서 타자를 칠 때 피아노를 연주하기 위해 키 입력 감지가 필요합니다."
      }
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
